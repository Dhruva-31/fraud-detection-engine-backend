generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String               @id @default(uuid())
  name            String
  email           String               @unique
  passwordHash    String
  createdAt       DateTime             @default(now())
  transactions    Transaction[]
  behaviorProfile UserBehaviorProfile?
}

model Transaction {
  id        String   @id @default(uuid())
  userId    String
  amount    Float
  merchant  String
  category  String
  latitude  Float
  longitude Float
  location  String
  timestamp DateTime @default(now())

  status TxStatus @default(CLEAN)

  riskScore      Int   @default(0)
  triggeredRules Json?

  fraudAlert FraudAlert?
  user       User        @relation(fields: [userId], references: [id])
}

model FraudAlert {
  id            String @id @default(uuid())
  transactionId String @unique

  createdAt DateTime @default(now())

  reviewed Boolean        @default(false)
  outcome  ReviewOutcome?

  reviewNotes String?

  transaction Transaction @relation(fields: [transactionId], references: [id])
}

model UserBehaviorProfile {
  id                   String   @id @default(uuid())
  userId               String   @unique
  avgTransactionAmount Float    @default(0)
  transactionStdDev    Float    @default(0)
  commonCategories     String   @default("")
  activeHours          String   @default("")
  lastKnownLocation    String?
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id])
}

enum TxStatus {
  CLEAN
  REVIEW
  FLAGGED
}

enum ReviewOutcome {
  FRAUD
  FALSE_POSITIVE
}
